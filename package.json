{
  "name": "self-evolve",
  "version": "1.5.6",
  "description": "evo-agent · Self-Evolving AI Agent — skills/memories/experiences that evolve with every task. Zero dependencies. npm i -g self-evolve && self-evolve",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "self-evolve": "./bin/self-evolve.js",
    "spa": "./bin/spa.js"
  },
  "files": [
    "bin/",
    "config/index.js",
    "core/",
    "service/",
    "store/",
    "tools/",
    "utils/",
    "web/",
    "extend/",
    "scripts/",
    "web.js",
    "tui.js",
    "app.js",
    "worker.js",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamsamyiok/self-evolving-agent.git"
  },
  "keywords": [
    "ai-agent",
    "self-evolving",
    "self-improving",
    "llm",
    "agent",
    "chatbot",
    "tools",
    "zero-dependency"
  ],
  "scripts": {
    "start": "node bin/self-evolve.js",
    "web": "node web.js",
    "tui": "node tui.js",
    "serve": "node app.js --serve",
    "watchdog": "node app.js --watchdog",
    "cluster": "node app.js --cluster 2",
    "headless": "node app.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js"
  }
}
