{
  "name": "self-purify-agent",
  "version": "1.0.0",
  "description": "自净化全自动进化 AI Agent —— 功能完整版（零依赖 Node.js，指导书 v2.0 三阶段全实现）",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "spa": "./bin/spa.js"
  },
  "scripts": {
    "start": "node tui.js",
    "serve": "node app.js --serve",
    "watchdog": "node app.js --watchdog",
    "cluster": "node app.js --cluster 2",
    "headless": "node app.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js"
  }
}
